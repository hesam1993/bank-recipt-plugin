<?xml version="1.0"?>
<ruleset name="Card to Card Receipts">
  <description>WordPress security and PHP compatibility checks.</description>
  <file>c2c-receipts.php</file>
  <file>includes</file>
  <file>uninstall.php</file>
  <arg name="extensions" value="php"/>
  <config name="testVersion" value="8.3-"/>
  <config name="text_domain" value="card-to-card-receipts-for-woocommerce"/>
  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.DB"/>
  <rule ref="WordPress.WP.I18n"/>
  <rule ref="PHPCompatibilityWP"/>
</ruleset>
